
<style>
.chase-scene {
  position: relative;
  width: 100%;
  height: 320px;
  overflow: hidden;
  border-radius: 22px;
  background: linear-gradient(
    to bottom,
    #9cddff 0%,
    #e5f7ff 68%,
    #9bd978 68%,
    #63b34b 100%
  );
  border: 3px solid white;
}

/* TAJUK */
.chase-title {
  position: absolute;
  top: 12px;
  width: 100%;
  text-align: center;
  font-size: 20px;
  font-weight: bold;
  color: #26743b;
  z-index: 5;
}

/* KUMPULAN WATAK */
.chase-group {
  position: absolute;
  bottom: 28px;
  left: -420px;
  display: flex;
  align-items: flex-end;
  gap: 8px;
  white-space: nowrap;
  animation: chaseMove 9s linear infinite;
}

/* GAMBAR PNG */
.chase-group img {
  display: block;
  object-fit: contain;
  object-position: bottom;
}

/* REMBO */
.rembo {
  width: 155px;
  height: 185px;
}

/* UPIN DAN IPIN */
.upin, .ipin {
  width: 115px;
  height: 165px;
}

/* GERAKAN */
@keyframes chaseMove {
  0% {
    left: -420px;
  }
  100% {
    left: 110%;
  }
}

/* TANAH */
.chase-ground {
  position: absolute;
  bottom: 0;
  height: 28px;
  width: 100%;
  background: #58a944;
  border-top: 4px solid #428d36;
}

/* AWAN */
.cloud {
  position: absolute;
  top: 45px;
  font-size: 38px;
}
.cloud-one { left: 12%; }
.cloud-two { right: 15%; }

/* BUTANG */
.chase-button {
  display: block;
  margin: 15px auto;
  padding: 11px 25px;
  border: none;
  border-radius: 25px;
  background: #35a75b;
  color: white;
  font-weight: bold;
  font-size: 15px;
  cursor: pointer;
}

@media(max-width: 500px) {
  .chase-scene {
    height: 260px;
  }

  .rembo {
    width: 115px;
    height: 140px;
  }

  .upin, .ipin {
    width: 85px;
    height: 125px;
  }

  .chase-group {
    bottom: 25px;
  }
}
</style>

<!-- ANIMASI REMBO MENGEJAR UPIN DAN IPIN -->
<div class="chase-scene" id="chaseScene">

  <div class="chase-title">
    🏃 REMBO MENGEJAR UPIN DAN IPIN!
  </div>

  <div class="cloud cloud-one">☁️</div>
  <div class="cloud cloud-two">☁️</div>

  <div class="chase-group" id="chaseGroup">

    <!-- REMBO DI BELAKANG -->
    <img src="rembo.png"
         class="rembo"
         alt="Rembo">

    <!-- UPIN -->
    <img src="upin.png"
         class="upin"
         alt="Upin">

    <!-- IPIN -->
    <img src="ipin.png"
         class="ipin"
         alt="Ipin">

  </div>

  <div class="chase-ground"></div>

</div>

<button class="chase-button" onclick="restartChase()">
  🔄 Ulang Animasi
</button>

<script>
function restartChase() {
  const group = document.getElementById("chaseGroup");

  group.style.animation = "none";
  group.offsetHeight;
  group.style.animation = "chaseMove 9s linear infinite";
}
</script>
